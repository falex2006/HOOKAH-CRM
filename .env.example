# CRM production environment template
# Copy to .env and replace every change_me/replace-* value before deployment.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change_me_postgres

# Production authentication and secure cookies
AUTH_REQUIRED=true
COOKIE_SECURE=true
DEMO_ADMIN_PASSWORD=change_me_admin
DEMO_OWNER_PASSWORD=change_me_owner
DEMO_STAFF_PASSWORD=change_me_staff
# Optional four-digit quick PIN for the staff demo account. Use a unique PIN in production.
DEMO_STAFF_PIN=change_me_pin

# Venue and reporting timezone (Tyumen)
VENUE_ID=00000000-0000-0000-0000-000000000001
BUSINESS_TIMEZONE=Asia/Yekaterinburg

# Required before storing passport data. Use a long random secret and keep it outside Git.
STAFF_PASSPORT_KEY=replace-with-a-long-random-secret

# SaaS platform owner (keep the real password in the local/VPS secret store, never Git)
SAAS_OWNER_EMAIL=platform-owner@example.com
SAAS_OWNER_PASSWORD=replace_with_a_strong_secret
