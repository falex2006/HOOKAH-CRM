# PostgreSQL connection for the VPS deployment
DATABASE_URL=postgresql://crm_user:change-me@127.0.0.1:5432/territory_crm

# Required before storing passport data. Use a long random secret and keep it outside Git.
STAFF_PASSPORT_KEY=replace-with-a-long-random-secret

# Set true in production after creating the owner account.
AUTH_REQUIRED=true
